# Google Cloud / Vertex AI (Required for Gemini via ADK)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Alternatively, rely on Application Default Credentials (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ClickHouse Cloud (Required for analytical memory via MCP)
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_password
CLICKHOUSE_SECURE=True

# The Movie Database (TMDB) API Key (Required for real movie recommendations)
TMDB_API_KEY=your_tmdb_api_key_here

# Google OAuth Client ID (Optional for Google Identity Services / Federated Login)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
